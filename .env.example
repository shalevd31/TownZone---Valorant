# --- Discord Application (מ-https://discord.com/developers/applications) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# טוקן של הבוט (מ-Bot tab באותה אפליקציה) - נדרש כדי לשלוח הודעות פרטיות
# עם פרטי הכניסה לנרשמים. הבוט חייב להיות חבר בשרת TownZone.
DISCORD_BOT_TOKEN=

# --- Riot Sign-On (RSO) - מ-developer.riotgames.com, אחרי אישור Production Key + RSO ---
RIOT_CLIENT_ID=
RIOT_CLIENT_SECRET=
RIOT_REDIRECT_URI=http://localhost:3000/auth/riot/callback
# americas | asia | europe | esports - איזור הניתוב של ה-Account API
RIOT_REGION=europe

# אופציונלי: מזהה השרת (Guild ID) של TownZone - אם מוגדר, המערכת תדרוש
# שהמשתמש יהיה חבר בשרת לפני שיוכל להירשם. השאירו ריק כדי לדלג על הבדיקה.
DISCORD_GUILD_ID=1459205527518056515

# קישור ההזמנה לשרת שיוצג באתר
DISCORD_INVITE_URL=https://discord.gg/townzone

# --- כללי ---
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=please-change-this-to-a-long-random-string

# --- פאנל ניהול (/admin) ---
ADMIN_USER=admin
ADMIN_PASSWORD=please-change-this-password
