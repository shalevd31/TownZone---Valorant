<%- include("partials/head", { title: "הרשמה לטורניר ולוראנט | TownZone" }) %>

<section class="card center">
  <h1>טורניר ולוראנט</h1>
  <p class="lead">בחרו הרשמה או כניסה כדי להמשיך.</p>

  <% if (sessionExpired) { %>
    <p class="alert">ההתחברות פגה, אנא התחברו שוב.</p>
  <% } %>

  <div class="choice-row">
    <a class="btn btn-primary btn-lg" href="/auth/discord">הרשמה</a>
    <a class="btn btn-secondary btn-lg" href="/login">כניסה</a>
  </div>

  <p class="hint">
    עדיין לא בשרת? הצטרפו קודם:
    <a href="<%= discordInviteUrl %>" target="_blank" rel="noopener"><%= discordInviteUrl.replace('https://','') %></a>
  </p>
</section>

<%- include("partials/foot") %>
