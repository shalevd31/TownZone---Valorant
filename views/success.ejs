<%- include("partials/head", { title: "נרשמת! | TownZone Valorant" }) %>

<div class="scanlines" aria-hidden="true"></div>

<% if (dmSent) { %>
  <p class="inline-note">✔ <strong><%= discordUsername %></strong>, שלחנו לך הודעה פרטית בדיסקורד עם שם המשתמש והסיסמה שלך.</p>
<% } else { %>
  <div class="alert wide">
    לא הצלחנו לשלוח לך הודעה פרטית בדיסקורד (ייתכן שהודעות פרטיות מחברי השרת חסומות אצלך).
    לכן, לפעם הזו בלבד, הנה פרטי הכניסה שלך — שמרו אותם, לא תראו אותם שוב:
    <ul class="check-list">
      <li>שם משתמש: <strong><%= username %></strong></li>
      <li>סיסמה: <strong><%= password %></strong></li>
    </ul>
  </div>
<% } %>

<section class="agent-carousel" aria-hidden="true">
  <div class="carousel-item" style="--agent-color:#ff4655">
    <img class="agent-portrait" src="https://media.valorant-api.com/agents/add6443a-41bd-e414-f6ad-e58d267f4e95/fullportrait.png" alt="Jett" />
    <div class="agent-name">Jett</div>
    <div class="agent-role">Duelist</div>
  </div>
  <div class="carousel-item" style="--agent-color:#ff9f45">
    <img class="agent-portrait" src="https://media.valorant-api.com/agents/eb93336a-449b-9c1b-0a54-a891f7921d69/fullportrait.png" alt="Phoenix" />
    <div class="agent-name">Phoenix</div>
    <div class="agent-role">Duelist</div>
  </div>
  <div class="carousel-item" style="--agent-color:#4a7dff">
    <img class="agent-portrait" src="https://media.valorant-api.com/agents/320b2a48-4d9b-a075-30f1-1f93a9b638fa/fullportrait.png" alt="Sova" />
    <div class="agent-name">Sova</div>
    <div class="agent-role">Initiator</div>
  </div>
  <div class="carousel-item" style="--agent-color:#2fd9a8">
    <img class="agent-portrait" src="https://media.valorant-api.com/agents/569fdd95-4d10-43ab-ca70-79becc718b46/fullportrait.png" alt="Sage" />
    <div class="agent-name">Sage</div>
    <div class="agent-role">Sentinel</div>
  </div>
  <div class="carousel-item" style="--agent-color:#8b5cf6">
    <img class="agent-portrait" src="https://media.valorant-api.com/agents/8e253930-4c05-31dd-1b6c-968525494517/fullportrait.png" alt="Omen" />
    <div class="agent-name">Omen</div>
    <div class="agent-role">Controller</div>
  </div>
  <div class="carousel-item" style="--agent-color:#f7d354">
    <img class="agent-portrait" src="https://media.valorant-api.com/agents/1e58de9c-4950-5125-93e9-a0aee9f98746/fullportrait.png" alt="Killjoy" />
    <div class="agent-name">Killjoy</div>
    <div class="agent-role">Sentinel</div>
  </div>
</section>

<section class="guest-card">
  <div class="guest-avatar">ש.פ</div>
  <div class="guest-text">
    <span class="guest-tag">הופעת אורח</span>
    <p>בהופעת אורח של שחקן הוולוראנט <strong>שון פי</strong></p>
  </div>
</section>

<section class="prize-hero">
  <h1 class="glitch-hover">ברוכים הבאים לטורניר ולוראנט של הקיץ<br />על <span class="prize-amount">700 ש"ח!</span></h1>
  <a class="btn btn-primary btn-huge val-pulse" href="/team/new">יצירת קבוצה לטורניר</a>
</section>

<section class="steps rules">
  <h2>פורמט וחוקי הטורניר</h2>
  <ul class="format-list">
    <li>🏆 <strong>הפרס:</strong> 700 ש"ח לקבוצה המנצחת. הפרס מועבר לקפטן הקבוצה, שאחראי לחלק אותו בין חברי הקבוצה.</li>
    <li>👑 <strong>הקפטן:</strong> נציג הקבוצה מול הצוות המארגן. הוא זה שמבצע את ההרשמה עבור כל חברי הקבוצה במערכת.</li>
    <li>👥 <strong>הרכב קבוצה:</strong> 5 שחקנים קבועים (קפטן + 4) + עד 2 מחליפים. מחליפים נכנסים רק בין סבבים (מפות) — לא באמצע משחק.</li>
    <li>📝 <strong>הרשמה:</strong> רק הקפטן נרשם באתר. הוא מזין את שמות שאר חברי הקבוצה, ה-Riot ID שלהם, ומה כל אחד משחק.</li>
    <li>🕐 <strong>שעת התחלה:</strong> כל משחקי הטורניר יוצאים לדרך בשעה 17:00 בדיוק. יש להגיע מוכנים.</li>
    <li>🎮 <strong>מבנה הטורניר:</strong> מספר הסבבים ייקבע לפי כמות הקבוצות שנרשמו, ויפורסם בשרת הדיסקורד.</li>
    <li>🤝 <strong>הדרכה:</strong> הצוות המארגן ילווה ויכוון את הטורניר יחד עם קפטני הקבוצות לאורך כל הדרך.</li>
    <li>🚫 <strong>הוגנות:</strong> אין להשתמש בצ'יטים, סקריפטים, או תרגילי רמאות. הפרת חוקים תוביל לפסילת הקבוצה.</li>
  </ul>
</section>

<section class="cta-footer center">
  <p>עדכונים לגבי הטורניר יישלחו בשרת הדיסקורד — הישארו קשובים.</p>
  <a class="btn btn-discord" href="<%= discordInviteUrl %>" target="_blank" rel="noopener">חזרה לשרת הדיסקורד</a>
</section>

<%- include("partials/foot") %>
